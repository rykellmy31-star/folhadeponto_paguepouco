{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["server", "web", "vite.config.ts", "vitest.config.ts"]
}
