{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jornada-ponto",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "jornada-db", "database_id": "ef8d42a5-b0b1-416d-abd0-e7947cef5cbc", "migrations_dir": "migrations" }],
  "vars": { "ENVIRONMENT": "production", "APP_ORIGIN": "https://configure-o-dominio.invalid", "SESSION_HOURS": "8" },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
